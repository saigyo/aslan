                text="Next Highlighted Usage in State Machine" description="Go to the next highlighted usage of the variable under the caret in the whole definition"
                use-shortcut-of="GotoNextElementUnderCaretUsage"/>
        <action id="Aslan.GotoPrevVariableUsage" class="io.github.saigyo.aslan.highlight.PrevVariableUsageAction"
                text="Previous Highlighted Usage in State Machine" description="Go to the previous highlighted usage of the variable under the caret in the whole definition"
                use-shortcut-of="GotoPrevElementUnderCaretUsage"/>
    </actions>
