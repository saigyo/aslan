        <lang.parserDefinition language="AslJsonata" implementationClass="io.github.saigyo.aslan.jsonata.parser.JsonataParserDefinition"/>
        <multiHostInjector implementation="io.github.saigyo.aslan.jsonata.inject.JsonataInjector"/>
        <lang.findUsagesProvider language="AslJsonata" implementationClass="io.github.saigyo.aslan.jsonata.refs.JsonataFindUsagesProvider"/>
        <readWriteAccessDetector implementation="io.github.saigyo.aslan.jsonata.refs.JsonataReadWriteAccessDetector"/>
        <lang.braceMatcher language="AslJsonata" implementationClass="io.github.saigyo.aslan.jsonata.edit.JsonataBraceMatcher"/>
        <quoteHandler fileType="AslJsonata" className="io.github.saigyo.aslan.jsonata.edit.JsonataQuoteHandler"/>
        <typedHandler order="first" implementation="io.github.saigyo.aslan.jsonata.edit.JsonataTypedHandler"/>
        <enterHandlerDelegate implementation="io.github.saigyo.aslan.jsonata.edit.JsonataEnterHandler"/>
        <lang.commenter language="AslJsonata" implementationClass="io.github.saigyo.aslan.jsonata.edit.JsonataCommenter"/>
        <lang.refactoringSupport language="AslJsonata" implementationClass="io.github.saigyo.aslan.jsonata.refs.JsonataRefactoringSupport"/>
        <lang.namesValidator language="AslJsonata" implementationClass="io.github.saigyo.aslan.jsonata.refs.JsonataNamesValidator"/>
        <targetElementEvaluator language="AslJsonata" implementationClass="io.github.saigyo.aslan.jsonata.refs.JsonataTargetElementEvaluator"/>
        <referencesSearch implementation="io.github.saigyo.aslan.jsonata.refs.JsonataReferencesSearcher"/>
        <renameHandler implementation="io.github.saigyo.aslan.jsonata.refs.JsonataInplaceRenameHandler"/>
        <renamePsiElementProcessor implementation="io.github.saigyo.aslan.jsonata.refs.JsonataVariableRenameProcessor"/>
        <completion.contributor language="AslJsonata" order="first" implementationClass="io.github.saigyo.aslan.jsonata.completion.JsonataCompletionContributor"/>
        <completion.contributor language="yaml" order="first" implementationClass="io.github.saigyo.aslan.completion.AslCompletionContributor"/>
        <completion.contributor language="JSON" order="first" implementationClass="io.github.saigyo.aslan.completion.AslCompletionContributor"/>
        <lang.documentationProvider language="AslJsonata" implementationClass="io.github.saigyo.aslan.jsonata.docs.JsonataDocumentationProvider"/>
        <codeInsight.parameterInfo language="AslJsonata" implementationClass="io.github.saigyo.aslan.jsonata.docs.JsonataParameterInfoHandler"/>
        <lang.documentationProvider language="yaml" order="first" implementationClass="io.github.saigyo.aslan.docs.AslDocumentationProvider"/>
        <lang.documentationProvider language="JSON" order="first" implementationClass="io.github.saigyo.aslan.docs.AslDocumentationProvider"/>
        <psi.referenceContributor language="yaml" implementation="io.github.saigyo.aslan.refs.AslReferenceContributor"/>
        <psi.referenceContributor language="JSON" implementation="io.github.saigyo.aslan.refs.AslReferenceContributor"/>
        <referencesSearch implementation="io.github.saigyo.aslan.refs.AslReferencesSearcher"/>
        <gotoDeclarationHandler implementation="io.github.saigyo.aslan.refs.AslVariableGotoDeclarationHandler"/>
        <findUsagesHandlerFactory order="first" implementation="io.github.saigyo.aslan.refs.AslVariableFindUsagesHandlerFactory"/>
        <readWriteAccessDetector implementation="io.github.saigyo.aslan.refs.AslVariableReadWriteAccessDetector"/>
        <renamePsiElementProcessor order="first" implementation="io.github.saigyo.aslan.refs.AslStateRenameProcessor"/>
        <renameInputValidator order="first" implementation="io.github.saigyo.aslan.refs.AslStateNameInputValidator"/>
        <renamePsiElementProcessor order="first" implementation="io.github.saigyo.aslan.refs.AslVariableRenameProcessor"/>
        <renameInputValidator implementation="io.github.saigyo.aslan.refs.AslVariableNameInputValidator"/>
        <yaml.customStructureViewFactory implementation="io.github.saigyo.aslan.structure.AslYamlStructureViewFactory"/>
        <json.customStructureViewFactory order="first" implementation="io.github.saigyo.aslan.structure.AslJsonStructureViewFactory"/>
        <highlightErrorFilter implementation="io.github.saigyo.aslan.jsonata.highlight.JsonataErrorFilter"/>
        <annotator language="yaml" implementationClass="io.github.saigyo.aslan.highlight.AslAnnotator"/>
        <annotator language="JSON" implementationClass="io.github.saigyo.aslan.highlight.AslAnnotator"/>
        <colorSettingsPage implementation="io.github.saigyo.aslan.highlight.AslColorSettingsPage"/>
        <lang.syntaxHighlighterFactory language="AslJsonata" implementationClass="io.github.saigyo.aslan.jsonata.highlight.JsonataSyntaxHighlighterFactory"/>
        <annotator language="AslJsonata" implementationClass="io.github.saigyo.aslan.jsonata.highlight.JsonataAnnotator"/>
        <colorSettingsPage implementation="io.github.saigyo.aslan.jsonata.highlight.JsonataColorSettingsPage"/>
        <highlightUsagesHandlerFactory implementation="io.github.saigyo.aslan.highlight.VariableUsagesHandlerFactory"/>
        <highlightUsagesHandlerFactory implementation="io.github.saigyo.aslan.highlight.PlaceholderUsagesHandlerFactory"/>
        <applicationConfigurable parentId="language" instance="io.github.saigyo.aslan.settings.AslConfigurable"
